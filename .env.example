PORT=8000
DEBUG=false
ENVIRONMENT=development

# Optional providers. Leave unset when using the built-in deterministic agents.
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
GEMINI_API_KEY=

# Persistence: SQLite is used by default. For Docker, set DATABASE_URL to the
# PostgreSQL URL shown in docker-compose.yml.
DATABASE_URL=
POSTGRES_USER=repoguard
POSTGRES_PASSWORD=change_me
POSTGRES_DB=repoguard_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
JWT_SECRET_KEY=replace_with_a_random_32_byte_or_longer_secret
MAX_DIFF_SIZE=500000
REVIEW_TOKEN_BUDGET=20000

QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me
REDIS_URL=redis://localhost:6379/0
