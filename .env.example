# ============================================================
# RepoGuard AI — Environment Configuration
# ============================================================
# Copy this file to .env and fill in real values.
# Variables marked [AUTO] were inferred from the codebase.
# Variables marked [USER] must be supplied manually.
# ============================================================

# ── Server ──────────────────────────────────────────────────
PORT=8000                       # [AUTO] docker-compose exposes 8000:8000
HOST=0.0.0.0
DEBUG=True
ENVIRONMENT=development

# ── LLM Providers ───────────────────────────────────────────
# [USER] Fill in your real keys below — existing keys are preserved.
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# ── Vector Database (Qdrant) ─────────────────────────────────
# [AUTO] Qdrant is used in part2_knowledge/embeddings.py via qdrant-client.
# Runs via docker-compose service "qdrant" (localhost for dev, "qdrant" in Docker).
QDRANT_HOST=localhost            # Change to "qdrant" when running inside Docker
QDRANT_PORT=6333
QDRANT_API_KEY=                 # Leave empty for local/self-hosted Qdrant (no auth needed)

# ── Knowledge Graph (Neo4j) ──────────────────────────────────
# [AUTO] Used in part2_knowledge/graph_builder.py.
# Falls back to in-memory NetworkX if Neo4j is not running — safe to leave as-is for dev.
# docker-compose auth → NEO4J_AUTH=neo4j/repoguard_secret
NEO4J_URI=bolt://localhost:7687  # Change to "bolt://neo4j:7687" inside Docker
NEO4J_USER=neo4j
NEO4J_PASSWORD=repoguard_secret

# ── Cache (Redis) ────────────────────────────────────────────
# [AUTO] docker-compose has a "redis:7-alpine" service on port 6379.
# Not yet referenced in backend Python code — placeholder for future use.
REDIS_URL=redis://localhost:6379/0   # Change to "redis://redis:6379/0" inside Docker

# ── Database (PostgreSQL) ────────────────────────────────────
# [AUTO] asyncpg/psycopg2/sqlalchemy are in requirements.txt but not yet called.
# Placeholder for future persistence layer — no action needed now.
POSTGRES_USER=repoguard
POSTGRES_PASSWORD=repoguard_pass
POSTGRES_DB=repoguard_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ── GitHub Integration ───────────────────────────────────────
# [USER] GitHub Personal Access Token — needed for repo cloning & API calls.
# Create at: GitHub → Settings → Developer Settings → Personal access tokens → Generate new token
# Required scopes: repo, admin:repo_hook (for webhook registration)
GITHUB_TOKEN=your_github_personal_access_token

# [AUTO] Webhook secret — cryptographically generated random value.
# This is used to verify incoming GitHub webhook payloads.
GITHUB_WEBHOOK_SECRET=9e309dc6517d9d34709102ec1d8c142ffa12d3b5d44bba85

# ── Authentication & Security ────────────────────────────────
# [AUTO] JWT secret — cryptographically generated (64 hex chars / 256-bit).
JWT_SECRET_KEY=271327662e1c257f4f217a2ebbe23851b3cdd085c9e6367e3aafd24e375538c2
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

PINECONE_API_KEY=pcsk_3LGuvP_5GbGZL2gZc9BGjHAAAreRCpQxXdUUw1pEKzory3BZhLEgnAuBwgiuc5VCySyohe
PINECONE_ENVIRONMENT=your_pinecone_env
WEAVIATE_URL=https://your-weaviate-instance.com
WEAVIATE_API_KEY=WEw5MCtxcVgxOXpPa1RuUV9ZWGFwNXdTM2dyQldiVGpHcUE5RmRXL2RtMzFDbkN3OU53RmxOcERkYk93PV92MjAw